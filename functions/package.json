{
  "name": "functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only auth,firestore,functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions:redeemPromoCode",
    "logs": "firebase functions:log",
    "create-code": "npm run build && node lib/scripts/createPromoCode.js"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
