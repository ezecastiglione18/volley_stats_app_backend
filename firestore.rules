rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas de la app RallyStats (login + control de dispositivo único).
    // Viven en otro repo (volley_stats_app), pero las reglas de Firestore
    // son por PROYECTO DE FIREBASE, no por repo/carpeta: si este archivo se
    // despliega sin incluirlas, se pisan las que hoy están pegadas a mano en
    // la consola (ver volley_stats_app/SETUP_FIREBASE.md) y se rompe el
    // login/control de dispositivo de la app. Si en algún momento cambian
    // del lado de la app, hay que traer el cambio también acá antes de
    // volver a desplegar `firestore:rules` desde este repo.
    match /account_devices/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Sync de partidos y equipos de la app (MatchSyncService, sección 3
    // Etapa 2 de RallyStats-Funcionalidades-Pendientes.pdf): solo si la
    // cuenta activó la nube. Cada cuenta lee y escribe únicamente lo suyo.
    // Los documentos padre matches/{uid} y teams/{uid} no existen: solo las
    // subcolecciones.
    match /matches/{uid}/user_matches/{matchId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /teams/{uid}/user_teams/{teamId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Jugadas de la pizarra y fixture (sección 8, opción A: el mismo sync y
    // el mismo interruptor que partidos y equipos). Mismo criterio: solo el
    // dueño del uid; los documentos padre tampoco existen.
    match /plays/{uid}/user_plays/{playId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /fixture/{uid}/user_fixture/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Códigos promocionales de premium (ver README/CLAUDE.md). Cerrados por
    // completo a los clientes: sólo la Cloud Function redeemPromoCode
    // (corre con el Admin SDK, que ignora estas reglas) los lee y escribe.
    // Así un usuario no puede leer códigos ajenos, inflar redeemedCount, ni
    // escribirse a sí mismo un documento de redemptions falso.
    match /promo_codes/{code} {
      allow read, write: if false;

      match /redemptions/{uid} {
        allow read, write: if false;
      }
    }
  }
}
